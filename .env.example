# ==============================
# Upvote — Variáveis de Ambiente
# ==============================
# Copie este arquivo para .env e preencha com os valores locais:
#   cp .env.example .env
#
# NUNCA commite o .env com valores reais!

# PostgreSQL (localhost em dev, Neon.tech em produção)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upvote
DB_USERNAME=upvote
DB_PASSWORD=upvote123

# JWT
JWT_SECRET=upvote-secret-key-for-development-only
JWT_EXPIRATION=86400000

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS
CORS_ORIGINS=http://localhost:5173

# RabbitMQ
RABBITMQ_USER=upvote
RABBITMQ_PASSWORD=upvote123

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# GCP (só necessário para deploy manual)
GCP_PROJECT_ID=project-38c32df4-c37c-41d9-b5d
