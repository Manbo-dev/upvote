# ==============================
# Upvote — Variáveis de Ambiente
# ==============================
# Copie este arquivo para .env e preencha com os valores locais:
#   cp .env.example .env
#
# NUNCA commite o .env com valores reais!

# PostgreSQL (localhost em dev, Neon.tech em produção)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upvote
DB_USERNAME=upvote
DB_PASSWORD=upvote123

# JWT
JWT_SECRET=upvote-secret-key-for-development-only
JWT_EXPIRATION=86400000

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS
CORS_ORIGINS=http://localhost:5173

# RabbitMQ
RABBITMQ_USER=upvote
RABBITMQ_PASSWORD=upvote123

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# Gemini AI (obrigatório para síntese real de feedback; sem isso usa StubAiService)
GEMINI_API_KEY=AIzaSy...

# Google OAuth (Google Identity Services — social login)
# Criar em: https://console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins: http://localhost:5173 e https://app.upvote.pro
# GOOGLE_CLIENT_ID → backend (valida o aud claim via tokeninfo)
# VITE_GOOGLE_CLIENT_ID → frontend (inicializa o GIS renderButton) — mesmo valor, prefixo VITE_ obrigatório para o Vite expor a variável
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# Jira Integration (https://developer.atlassian.com/console/myapps/)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# ClickUp Integration (https://app.clickup.com/settings/integrations)
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=

# OAuth Callback Base URL (frontend)
# Dev:  http://localhost:5173
# Prod: https://upvote.pro
OAUTH_CALLBACK_BASE_URL=http://localhost:5173

# GCP (só necessário para deploy manual)
GCP_PROJECT_ID=project-38c32df4-c37c-41d9-b5d
