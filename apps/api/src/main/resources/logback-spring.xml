<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Perfil de desenvolvimento: saída legível no console com cores.
        Ativado quando o profile Spring NÃO é "prod".
    -->
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %5p [tx:%X{transactionId:--}] [origin:%X{widgetOrigin:--}] --- [%15.15t] %-40.40logger{39} : %m%n%ex</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <!-- Reduzir ruído de frameworks em dev -->
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
    </springProfile>

    <!--
        Perfil de produção: saída JSON estruturado compatível com Cloud Logging.
        O GKE coleta stdout automaticamente via Fluent Bit e envia ao Cloud Logging.
        O campo "severity" é reconhecido pelo Cloud Logging para filtrar por nível.
    -->
    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">

                <!-- Renomeia "level" para "severity" — padrão do Cloud Logging -->
                <fieldNames>
                    <level>severity</level>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>

                <!-- Converte o nível para uppercase (INFO, WARN, ERROR) -->
                <provider class="net.logstash.logback.composite.loggingevent.LogLevelJsonProvider">
                    <fieldName>severity</fieldName>
                </provider>

                <!-- Inclui contexto MDC (ex: requestId, userId, canalSlug) -->
                <includeMdc>true</includeMdc>

                <!-- Inclui stack trace completo em caso de exceção -->
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerCause>20</maxDepthPerCause>
                    <shortenedClassNameLength>20</shortenedClassNameLength>
                    <exclude>sun\.reflect\..*\.invoke.*</exclude>
                </throwableConverter>

            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>

        <!-- Silenciar logs verbosos desnecessários em produção -->
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="com.zaxxer.hikari" level="WARN"/>
        <logger name="org.flywaydb" level="INFO"/>

        <!-- Logs da aplicação em INFO -->
        <logger name="com.upvote" level="INFO"/>
    </springProfile>

</configuration>
