{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (apps/web)",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "export PATH=/opt/homebrew/bin:$PATH && npm run dev"],
      "cwd": "apps/web",
      "port": 5173
    },
    {
      "name": "Backend API (apps/api)",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["spring-boot:run"],
      "cwd": "apps/api",
      "port": 8080
    },
    {
      "name": "Widget (packages/widget)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "packages/widget",
      "port": 3000
    },
    {
      "name": "Sandbox (apps/sandbox)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "cwd": "apps/sandbox",
      "port": 3333,
      "autoPort": false
    },
    {
      "name": "Infraestrutura (Docker)",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["up", "-d"],
      "cwd": ".",
      "port": null
    }
  ]
}
